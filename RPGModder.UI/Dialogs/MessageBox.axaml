<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RPGModder.UI.Dialogs.MessageBox"
        Title="Message" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        SystemDecorations="BorderOnly" Background="#1E1E1E" ExtendClientAreaToDecorationsHint="True">

    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
        <StackPanel Margin="24" Spacing="25">
            <TextBlock Name="TxtTitle" Text="Title" FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Name="TxtMessage" Text="Message goes here..." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="14" LineHeight="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Name="BtnCancel" Content="Cancel" IsVisible="False" Padding="20,10"/>
                <Button Name="BtnOk" Content="OK" Classes="primary" Padding="30,10" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>